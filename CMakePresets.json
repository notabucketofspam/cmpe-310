{
  "version": 3,
  "configurePresets": [
    {
      "name": "avr-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/avr.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ARDUINO_CORE_DIR": "C:/opt/atmel/ArduinoCore-avr"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-arm"
        }
      }
    },
    {
      "name": "lab6",
      "inherits": "avr-base",
      "displayName": "lab6",
      "cacheVariables": {
        "TARGET_LAB": "lab6"
      }
    },
    {
      "name": "lab7",
      "inherits": "avr-base",
      "displayName": "lab7",
      "cacheVariables": {
        "TARGET_LAB": "lab7"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-lab6",
      "configurePreset": "lab6",
      "displayName": "Build lab6"
    },
    {
      "name": "flash-lab6",
      "configurePreset": "lab6",
      "displayName": "Flash lab6",
      "targets": [ "upload_lab6" ]
    }
  ]
}
